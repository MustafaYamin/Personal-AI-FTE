# Copy to .env for local (non-docker) runs. Under docker-compose these are injected instead.

ENVIRONMENT=development
DEBUG=true

# Postgres
DATABASE_URL=postgresql+asyncpg://ai_fte:ai_fte@localhost:5432/ai_fte

# Redis (rate limiting, caching)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# DB pool sizing (tune for expected concurrency; see core/db.py)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
